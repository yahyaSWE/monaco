# Public production origin for canonical URLs and sitemap (no trailing slash).
NEXT_PUBLIC_SITE_URL=https://monacoclinic.se

# Server-only: disable indexing for a custom preview or self-hosted staging deployment.
# SITE_INDEXING_ENABLED=false

# Server-only: Instagram API with Instagram Login, never use NEXT_PUBLIC_ for these.
INSTAGRAM_USER_ID=
INSTAGRAM_ACCESS_TOKEN=

# Optional ownership verification values from Google Search Console / Bing Webmaster Tools.
# Paste the supplied meta-tag content values, not HTML markup.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
